<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ImageCropper.Sample.MainPage" Title="Image cropper">
  <VerticalStackLayout Padding="24" Spacing="16">
    <Button Text="Choose an image" Clicked="ChooseImage" />
    <Button Text="Try sample image" Clicked="TrySampleImage" />
    <Label x:Name="Status" />
    <Image x:Name="Preview" Aspect="AspectFit" HeightRequest="350" />
  </VerticalStackLayout>
</ContentPage>
