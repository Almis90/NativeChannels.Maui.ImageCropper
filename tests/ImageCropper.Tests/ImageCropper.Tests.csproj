<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(TestWindows)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(TestWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestWindows)' == 'true'">
    <!-- CI has no installed Windows App Runtime or interactive desktop. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapAutoInitializeOptions_None>true</WindowsAppSDKBootstrapAutoInitializeOptions_None>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NativeChannels.Core" Version="0.1.0-preview.2" />
    <Compile Include="../../src/NativeChannels.Maui.ImageCropper/CropRegion.cs" Link="CropRegion.cs" />
    <Compile Include="../../src/NativeChannels.Maui.ImageCropper/IImageCropper.cs" Link="IImageCropper.cs" />
    <Compile Include="../../src/NativeChannels.Maui.ImageCropper/ImageCropper.cs" Link="ImageCropper.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TestWindows)' == 'true'">
    <ProjectReference Include="../../native/windows/NativeChannels.Maui.ImageCropper.Windows.csproj" />
  </ItemGroup>
</Project>
