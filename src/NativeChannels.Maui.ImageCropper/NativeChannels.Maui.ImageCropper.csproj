<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <PackageId>NativeChannels.Maui.ImageCropper</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Almis</Authors>
    <Description>Native image cropping for Android, iOS, Mac Catalyst and Windows through NativeChannels.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NativeChannels.Maui" Version="0.1.0-preview.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="../../native/windows/NativeChannels.ImageCropper.Native.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">

    </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <ProjectReference Include="../../native/android/NativeChannels.ImageCropper.Native.Android.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
    <ProjectReference Include="../../native/apple/NativeChannels.ImageCropper.Native.Apple.csproj" />
  </ItemGroup>
</Project>
