<Project>
  <PropertyGroup>
    <ImageCropperNativeRoot Condition="'$(ImageCropperNativeRoot)' == ''">$(MSBuildThisFileDirectory)../native/</ImageCropperNativeRoot>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
    <NativeReference Include="$(ImageCropperNativeRoot)apple/Mantis.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>false</SmartLink>
    </NativeReference>
    <NativeReference Include="$(ImageCropperNativeRoot)apple/MauiImageCropperNative.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>false</SmartLink>
    </NativeReference>
  </ItemGroup>
  <Target Name="ValidateImageCropperAppleAssets" BeforeTargets="PrepareForBuild" Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
    <Error Condition="!Exists('$(ImageCropperNativeRoot)apple/Mantis.xcframework/Info.plist') Or !Exists('$(ImageCropperNativeRoot)apple/MauiImageCropperNative.xcframework/Info.plist')" Text="ImageCropper Apple native assets are missing. Build them on macOS with eng/prepare-native.py and eng/build-apple.py." />
  </Target>
</Project>