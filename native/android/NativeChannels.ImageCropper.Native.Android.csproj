<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <PackageId>NativeChannels.ImageCropper.Native.Android</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Almis</Authors>
    <Description>Android native image cropper adapter for NativeChannels.</Description>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsBindingProject>false</IsBindingProject>
    <EnableDefaultAndroidItems>false</EnableDefaultAndroidItems>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/*.targets" Pack="true" PackagePath="buildTransitive/" />
    <PackageReference Include="NativeChannels.Native.Android" Version="0.1.0-preview.2" />
    <PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.5.2" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.10.1.3" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.16.0.3" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.Kotlin.Parcelize.Runtime" Version="2.3.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.10.2.3" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core.Jvm" Version="1.10.2.3" />
    <None Include="../../artifacts/native/android/imagecropper.aar" Pack="true" PackagePath="native/android/" />
    <None Include="../../artifacts/native/android/android-image-cropper-4.7.0.aar" Pack="true" PackagePath="native/android/" />
    <None Include="CanHub-LICENSE.txt" Pack="true" PackagePath="native/android/" />
  </ItemGroup>
</Project>